# Gridmatic Dashboard Environment Variables
# Copy this file to .env.local and fill in your values

# Google Cloud Configuration
GCP_PROJECT=gridmatic-473617
BQ_DATASET=energy_ercot

# Service Account Key (for local development)
# Download from GCP Console: IAM → Service Accounts → Create Service Account
# Grant "BigQuery Data Viewer" role
# Download JSON key and place in project root
GOOGLE_APPLICATION_CREDENTIALS=./gridmatic-bq-key.json

# For production deployment (Vercel): prefer adding the full SA JSON into:
# GCP_SA_KEY_JSON=
# The API routes will parse this and authenticate to BigQuery.
